+{% extends "base.html" %}
+
+{% block title %}{{ discussion.title }}{% endblock title %}
+
+{% block content %}
+<div class="container mx-auto px-4 py-8 max-w-3xl">
+    <div class="mb-6">
+        <a href="{% url 'discussion_list' %}" class="text-blue-500 hover:underline">&larr; К списку обсуждений</a>
+        <h1 class="text-3xl font-bold text-gray-800 mt-2">{{ discussion.title }}</h1>
+        {% if discussion.task %}
+            <p class="text-sm text-gray-600">
+                Связано с задачей: <a href="{% url 'task_detail' discussion.task.id %}" class="text-blue-500 hover:underline">{{ discussion.task.title }}</a>
+            </p>
+        {% endif %}
+    </div>
+
+    <!-- Message List -->
+    <div id="message-list" class="space-y-4 mb-6">
+        {% for message in messages %}
+            {% include "core/discussions/message.html" %}
+        {% empty %}
+            <p id="no-messages-placeholder" class="text-gray-500 text-center py-4">Сообщений пока нет. Начните диалог!</p>
+        {% endfor %}
+    </div>
+
+    <!-- Message Form -->
+    <div class="sticky bottom-0 bg-white/80 backdrop-blur-sm py-4">
+        <form
+            hx-post="{% url 'message_create' discussion.id %}"
+            hx-target="#message-list"
+            hx-swap="beforeend"
+            hx-on="htmx:afterRequest: this.reset()"
+        >
+            {% csrf_token %}
+            <div class="flex items-start space-x-3">
+                {{ form.text }}
+                <button type="submit" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500">
+                    Отправить
+                </button>
+            </div>
+             {% if form.text.errors %}
+                <p class="text-red-500 text-xs mt-1">{{ form.text.errors|join:", " }}</p>
+            {% endif %}
+        </form>
+    </div>
+</div>
+{% endblock content %}
