APP_DOMAIN=app.example.com
# При запуске через docker/deploy.sh значение подставляется из Git автоматически.
APP_RELEASE_SHA=unknown
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
TELEGRAM_BOT_TOKEN=replace-with-rotated-bot-token
# Личные Telegram ID через запятую получают доступ без приглашения.
TELEGRAM_ALLOWED_IDS=123456789,987654321
# Дополнительные глобальные администраторы приложения. Им доступны приглашения,
# удаление участников проектов и любых обсуждений. ID 7836566387 уже добавлен
# в постоянный список приложения.
TELEGRAM_ADMIN_IDS=737320461
# Username бота без @. В @BotFather включите Main Mini App на APP_DOMAIN;
# для браузерного Telegram Login также зарегистрируйте домен через /setdomain.
TELEGRAM_BOT_USERNAME=your_bot_username
# Резервный официальный IPv4 Telegram Bot API для сетей, где DNS-маршрут
# до основного адреса недоступен. Проверяйте его при инцидентах уведомлений.
TELEGRAM_API_IPV4=149.154.167.220
PRIVACY_OPERATOR_NAME=Имя или наименование оператора
PRIVACY_CONTACT=privacy@example.com
SUPPORT_CONTACT=support@example.com
TELEGRAM_SECURE_COOKIES=True
SECURE_SSL_REDIRECT=True
# Начните с часа, после проверки увеличьте до 31536000.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_AGE=604800
DATA_UPLOAD_MAX_MEMORY_SIZE=2097152
DATA_UPLOAD_MAX_NUMBER_FIELDS=200
DATABASE_PATH=/app/data/db.sqlite3
SQLITE_TIMEOUT=30
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60
DEADLINE_CHECK_INTERVAL_SECONDS=900
OUTBOUND_POLL_INTERVAL_SECONDS=5
TELEGRAM_NOTIFICATION_MAX_ATTEMPTS=5
TELEGRAM_NOTIFICATION_RETRY_SECONDS=900
BACKUP_HOST_DIR=/opt/krugok-backups
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
LOG_LEVEL=INFO
DJANGO_REQUEST_LOG_LEVEL=WARNING
